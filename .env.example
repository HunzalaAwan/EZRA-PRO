# ---------------------------------------------------------------------------
# EZRA Pro - environment
# The demo runs with ZERO configuration; everything below is for the real stack.
# Copy to .env.local and fill in when you wire up production services.
# ---------------------------------------------------------------------------

# Root domain used for tenant subdomain routing (see src/middleware.ts)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Postgres - matches prisma/schema.prisma
DATABASE_URL="postgresql://user:password@localhost:5432/ezrapro?schema=public"

# Auth
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM="EZRA Pro <bookings@ezrapro.com>"

# Object storage for activity media
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
